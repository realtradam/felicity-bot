#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
SCANNER=ghcr.io/gitleaks/gitleaks@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f
mkdir -p .cache
snapshot="$(mktemp -d "$ROOT/.cache/secret-scan.XXXXXX")"
trap 'rm -rf "$snapshot"' EXIT
# Scan all Git-eligible working files, even before the first commit. Never copy ignored .env/data.
while IFS= read -r -d '' path; do
  [[ -f "$path" ]] || continue
  if [[ -L "$path" ]]; then printf 'Review symlink before publishing: %s\n' "$path" >&2; exit 1; fi
  mkdir -p "$snapshot/$(dirname "$path")"
  cp -- "$path" "$snapshot/$path"
done < <(git ls-files --cached --others --exclude-standard -z)
docker run --rm -v "$snapshot:/scan:ro" -v "$ROOT/.gitleaks.toml:/config.toml:ro" \
  "$SCANNER" dir /scan --config /config.toml --redact --no-banner
if git rev-parse --verify HEAD >/dev/null 2>&1; then
  # Full reachable local Git history, not merely the latest diff.
  docker run --rm -v "$ROOT:/repo:ro" "$SCANNER" git /repo \
    --config /repo/.gitleaks.toml --redact --no-banner --log-opts="--all --full-history"
fi

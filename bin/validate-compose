#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"
# Never read .env, expand real credentials, print rendered config or start services.
for spec in 'docker-compose.yml felicity-dev' 'docker-compose.prod.yml felicity-prod'; do
  read -r file project <<< "$spec"
  env -i PATH="$PATH" HOME="$HOME" \
    DISCORD_TOKEN=validation-only DISCORD_CLIENT_ID=123456789012345678 \
    docker compose --env-file /dev/null -p "$project" -f "$ROOT/$file" config --quiet
done
printf 'Development/production Compose validated offline with placeholders only.\n'

#!/usr/bin/env bash
set -euo pipefail
if [[ -t 0 ]]; then export GPG_TTY="$(tty)"; fi
key=projects/discordbot-felicity/dev/discord_token
if gopass show -o "$key" >/dev/null 2>&1; then
  printf 'Development token already exists. Use gopass edit %s to replace it.\n' "$key"
  exit 0
fi
printf 'Create a bot in the Discord Developer Portal, then copy its bot token.\n'
read -rsp 'Discord development bot token: ' token
printf '\n'
[[ -n "$token" ]] || { printf 'Token must not be empty.\n' >&2; exit 1; }
printf '%s\n' "$token" | gopass insert -f "$key"
unset token

#!/usr/bin/env bash
set -euo pipefail
if [[ -t 0 ]]; then export GPG_TTY="$(tty)"; fi
key=projects/discordbot-felicity/prod/discord_token
# Check -> prompt/store -> output to stdout for the deployment platform only.
if ! gopass show -o "$key" >/dev/null 2>&1; then
  printf 'Use a separate production Discord application/bot token.\n' >&2
  read -rsp 'Discord production bot token: ' token
  printf '\n' >&2
  [[ -n "$token" ]] || { printf 'Token must not be empty.\n' >&2; exit 1; }
  printf '%s\n' "$token" | gopass insert -f "$key" >&2
  unset token
fi
printf 'DISCORD_TOKEN=%s\n' "$(gopass show -o "$key")"

# Copy to .env and supply your bot token. Do not commit .env.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=690681378718613615
LOG_LEVEL=info
PREVIEW_CACHE_SIZE=100

# Optional reset/feature notifications: the existing free-tier Vercel Gateway key.
# Either name works; AI_GATEWAY_API_KEY takes precedence. Never enable auto-recharge.
AI_GATEWAY_API_KEY=
VERCEL_TOKEN=
OPENAI_RESET_ENABLED=true

# Optional AI chat and image generation via Logfare (logs prompts and completions).
LOGFARE_API_KEY=
AI_CHAT_ENABLED=true

# Optional sole AI tool: Exa search through the Umans relay (never Firecrawl).
UMANS_API_KEY=
